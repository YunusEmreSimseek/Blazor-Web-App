@page "/movie-details/{imdbId}"
@using BlazorApp1.Models
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<BlazorApp1.Resources.SharedResource> L
@inject IMovieService _movieService
@inject UserSessionManager _userSessionManager
@inject NavigationManager _navManager



<PageTitle>@L["movieDetails"]</PageTitle>

<h1>@L["movieDetails"]</h1>

@if (_isLoading)
{
    <LoadingComp />
}
else
{
    <TelerikCard>
        <CardHeader>
            <h3>@_movie.Title (@_movie.Year)</h3>
        </CardHeader>
        <CardBody>
            <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
                <div style="flex: 1;">
                    <p><strong>Genre:</strong> @_movie.Genre</p>
                    <p><strong>Director:</strong> @_movie.Director</p>
                    <p><strong>IMDb Rating:</strong> @_movie.imdbRating</p>
                    <p><strong>Plot:</strong> @_movie.Plot</p>
                    <p><strong>Country:</strong> @_movie.Country</p>
                    <p><strong>Language:</strong> @_movie.Language</p>
                    <p><strong>Writer:</strong> @_movie.Writer</p>
                    <p><strong>Type:</strong> @_movie.Type</p>
                    <p><strong>Released:</strong> @_movie.Released</p>
                    <p><strong>Ratings:</strong>
                        @foreach (var rating in _movie.Ratings)
                        {
                            <br />
                            <span> @rating.Source: @rating.Value</span>
                        }
                    </p>
                    <p><strong>Production:</strong> @_movie.Production</p>
                    <p><strong>Rated:</strong> @_movie.Rated</p>
                    <p><strong>Runtime:</strong> @_movie.Runtime</p>
                    <p><strong>Actors:</strong> @_movie.Actors</p>
                    <p><strong>Awards:</strong> @_movie.Awards</p>
                    <p><strong>MetaScore:</strong> @_movie.Metascore</p>
                    <p><strong>ImdbVotes:</strong> @_movie.imdbVotes</p>
                    <p><strong>imdbID:</strong> @_movie.imdbID</p>
                    <p><strong>DVD:</strong> @_movie.DVD</p>
                    <p><strong>BoxOffice:</strong> @_movie.BoxOffice</p>
                    <p><strong>Website:</strong> @_movie.Website</p>
                    <p><strong>Response:</strong> @_movie.Response</p>
                </div>

                <div>
                    <img src="@_movie.Poster" width="500px" height="600px" alt="Poster"
                        style="object-fit:cover; border-radius:8px;" />
                </div>
            </div>
        </CardBody>
    </TelerikCard>
}




@code {
    [Parameter] public string? imdbId { get; set; } = "tt0078346";
    private bool _isLoading = false;
    private Movie _movie = new Movie();

    protected override void OnInitialized()
    {
        if (!_userSessionManager.IsAuthenticated)
        {
            _navManager.NavigateTo("/login");
            return;
        }
    }
    protected override async Task OnInitializedAsync()
    {


        if (!string.IsNullOrEmpty(imdbId))
        {
            await LoadMovie();
        }
    }

    private async Task LoadMovie()
    {
        _isLoading = true;
        try
        {
            _movie = await _movieService.GetMovieByIdAsync(imdbId!);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading movie: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }
}