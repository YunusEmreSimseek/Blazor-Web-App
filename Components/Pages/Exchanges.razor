@page "/exchanges"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using BlazorApp1.Models
@using Microsoft.Extensions.Localization
@using ApexCharts
@using Microsoft.AspNetCore.Components
@using Telerik.DataSource
@inject NavigationManager NavigationManager
@inject IStringLocalizer<BlazorApp1.Resources.SharedResource> L
@inject IExchangeService ExchangeService


<PageTitle>@L["exchanges"]</PageTitle>

<h1>@L["exchanges"]</h1>

@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">@L["loading"]...</span>
        </div>
    </div>
}
else
{
    @if (_exchanges.Count == 0)
    {


        <h5>@L["exchangesCurrencyTitle"]</h5>

        @foreach (var currency in _allCurrencies)
        {
            <div>
                <input type="checkbox" @onchange="@(() => ToggleCurrency(currency))" checked="@_currencies.Contains(currency)" />
                <label>@currency.ToString()</label>
            </div>
        }

        <div class="mb-3" />

        <h5>@L["exchangesComponentTitle"]</h5>

        @foreach (var mode in _allModes)
        {
            <div>
                <input type="checkbox" @onchange="@(() => _showMode = mode)" checked="@CheckedMode(mode)" />
                <label>@mode.ToString()</label>
            </div>
        }
        <div class="mb-3" />

        <h5>@L["exchangesSubtitle"]</h5>
        <div class="w-25">
            <input class="form-control" type="date" placeholder="@L["startDate"]" @bind="_startDate" />
            <input class="form-control" type="date" placeholder="@L["endDate"]" @bind="_endDate" />
        </div>

        <div class="mb-3" />
        <button class="btn btn-primary" type="button" @onclick="HandleRedraw">@L["getExchangeRates"]</button>


    }
    else
    {
        @if (_showMode == ShowMode.Graphic || _showMode == ShowMode.All)
        {
            <p>This is exchange reates from @_startDate to @_endDate for
                @if (_currencies.Count > 1)
                {
                    @foreach (var currency in _currencies)
                    {
                        if(currency != _currencies.Last())
                        {
                            <label>@currency.ToString(), </label>
                        }
                        else
                        {
                            <label>@currency.ToString() to MKD</label>
                        }
                    }
                }
                else {
                    @foreach (var currency in _currencies)
                    {
                        <label>@currency.ToString() to MKD</label>
                    }
                }

            </p>

            <ApexChart TItem="ChartDataModel" Title=@L["exchangeRates"] Height="600">

                @if (_currencies.Contains(Currency.EUR))
                {
                    <ApexPointSeries TItem="ChartDataModel" Items="_chartData" Name="1 EUR" SeriesType="SeriesType.Line"
                        XValue="e => e.DateLabel" YValue="e=> e.EurRate" />
                }
                @if (_currencies.Contains(Currency.USD))
                {
                    <ApexPointSeries TItem="ChartDataModel" Items="_chartData" Name="1 USD" SeriesType="SeriesType.Line"
                        XValue="e => e.DateLabel" YValue="e=> e.UsdRate" />
                }
                @if (_currencies.Contains(Currency.TRY))
                {
                    <ApexPointSeries TItem="ChartDataModel" Items="_chartData" Name="1 TRY" SeriesType="SeriesType.Line"
                        XValue="e => e.DateLabel" YValue="e=> e.TryRate" />
                }

            </ApexChart>
        }

        @if (_showMode == ShowMode.All || _showMode == ShowMode.Table)
        {

            <TelerikGrid Class="grid" Data=@_exchanges Pageable="true" Sortable="true" Resizable="true" PageSize="10"
                Navigable="true" FilterMode="GridFilterMode.FilterMenu" Reorderable="true">
                <GridColumns>
                    <GridColumn Field="@nameof(ExchangeRate.Datum)" DisplayFormat="{0:dd.MM.yyyy}" Title=@L["date"] Width="195px" />
                    <GridColumn Field="@nameof(ExchangeRate.Oznaka)" Title=@L["currency"] Width="195px" />
                    <GridColumn Field="@nameof(ExchangeRate.DrzavaAng)" Title=@L["country"] Width="195px" />
                    <GridColumn Field="@nameof(ExchangeRate.NazivAng)" Title=@L["name"] Width="195px" />
                    <GridColumn Field="@nameof(ExchangeRate.Sreden)" Title=@L["average"] Width="195px" />
                    <GridColumn Field="@nameof(ExchangeRate.Kupoven)" Title=@L["exchangesPurchase"] Width="195px" />
                    <GridColumn Field="@nameof(ExchangeRate.Prodazen)" Title=@L["exchangesSale"] Width="195px" />
                </GridColumns>
            </TelerikGrid>

        }
    }

@code {
    private List<ExchangeRate> _exchanges = new();
    private List<ExchangeRate> _filteredExchanges = new();
    private bool _isLoading = false;
    private DateTime _startDate = DateTime.Now;
    private DateTime _endDate = DateTime.Now;
    private string _message = "";
    private List<ChartDataModel> _chartData = new();
    private ShowMode _showMode = ShowMode.All;
    private IEnumerable<ShowMode> _allModes => Enum.GetValues(typeof(ShowMode)).Cast<ShowMode>();
    private bool CheckedMode(ShowMode mode) => _showMode == mode;
    private List<Currency> _currencies = new() { Currency.EUR };
    private IEnumerable<Currency> _allCurrencies => Enum.GetValues(typeof(Currency)).Cast<Currency>();


    private void ToggleCurrency(Currency currency)
    {
        if (_currencies.Contains(currency))
            _currencies.Remove(currency);
        else
            _currencies.Add(currency);
    }

    private void OnSearch(string searchTerm)
    {
        if (string.IsNullOrEmpty(searchTerm))
        {
            _filteredExchanges = new();
            return;
        }

        _filteredExchanges = _exchanges
        .Where(e => e.Oznaka.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        e.DrzavaAng.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        e.NazivAng.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList();

    }
    private async Task GetExchangeRates()
    {
        _isLoading = true;
        try
        {
            if (_startDate == default || _endDate == default)
            {
                _message = L["exchangesNoDatesError"];
                return;
            }

            var exchanges = await ExchangeService.GetExchangeRatesAsync(_startDate, _endDate);
            if (exchanges is null || exchanges.Count == 0)
            {
                _message = L["exchangesNoRatesError"];
                return;
            }

            _exchanges = exchanges;
            _message = "";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching exchange rates: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleRedraw()
    {
        await GetExchangeRates();

        string[] labels = _exchanges
        .Select(e => e.Datum.ToString("dd-MM-yyyy"))
        .Distinct()
        .ToArray();

        List<double> _eurValues = _exchanges
        .Where(e => e.Oznaka == "EUR")
        .Select(e => e.Sreden)
        .ToList();

        List<double> _usdValues = _exchanges
        .Where(e => e.Oznaka == "USD")
        .Select(e => e.Sreden)
        .ToList();

        List<double> _tryValues = _exchanges
        .Where(e => e.Oznaka == "TRY")
        .Select(e => e.Sreden)
        .ToList();

        _chartData = new List<ChartDataModel>();
        for (int i = 0; i < labels.Length; i++)
        {
            double roundedEur = Math.Round(_eurValues[i], 2);
            double roundedUsd = Math.Round(_usdValues[i], 2);
            double roundedTry = Math.Round(_tryValues[i], 2);
            var truncatedEur = TruncateToTwoDecimals((decimal)_eurValues[i]);
            var truncatedUsd = TruncateToTwoDecimals((decimal)_usdValues[i]);
            var truncatedTry = TruncateToTwoDecimals((decimal)_tryValues[i]);

            _chartData.Add(new ChartDataModel
            {
                DateLabel = labels[i],
                EurRate = i < _eurValues.Count ? truncatedEur : 0,
                UsdRate = i < _usdValues.Count ? truncatedUsd : 0,
                TryRate = i < _tryValues.Count ? truncatedTry : 0
            });
        }
        StateHasChanged();

    }



    public class ChartDataModel
    {
        public string DateLabel { get; set; } = string.Empty;
        public decimal EurRate { get; set; }
        public decimal TryRate { get; set; }
        public decimal UsdRate { get; set; }

    }

    private decimal TruncateToTwoDecimals(decimal value)
    {
        return Math.Truncate(value * 100) / 100;
    }

    enum Currency
    {
        EUR,
        USD,
        TRY
    }

    private enum ShowMode
    {
        Graphic, Table, All
    }


}

}